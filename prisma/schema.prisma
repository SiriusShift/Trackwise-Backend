generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  Pending
  Completed
  Skipped
}

enum Type {
  Expense
  Income
  Transfer
}

enum NotificationType {
  Reminder
  System
  General
  Warning
  Info
  Success
  Error
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum RecurringBehaviour {
  AUTO_LOG
  REMIND
}

enum RecurringLogResult {
  CREATED
  REMINDED
  SKIPPED
  FAILED
}

enum AssetCategory {
  CASH
  BANK
  CREDIT
  LOAN
  INVESTMENT
}

enum LoanInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  SKIPPED
}

// NOTE: Prisma cannot enforce which AssetSubtype values are valid for a given
// AssetCategory at the DB level (no discriminated unions). Enforce this
// mapping in application-layer validation (e.g. a zod schema keyed by category):
//   BANK       -> SAVINGS | CHECKING | E_WALLET
//   CREDIT     -> CREDIT_CARD | LINE_OF_CREDIT
//   LOAN       -> PERSONAL | HOME | AUTO
//   INVESTMENT -> STOCK | ETF | CRYPTO | MUTUAL_FUND | BOND
//   CASH       -> null (no subtype)
enum AssetSubtype {
  // BANK
  SAVINGS
  CHECKING
  E_WALLET

  // CREDIT
  CREDIT_CARD
  LINE_OF_CREDIT

  // LOAN
  PERSONAL
  HOME
  AUTO

  // INVESTMENT
  STOCK
  ETF
  CRYPTO
  MUTUAL_FUND
  BOND
}

enum InterestMethod {
  ADD_ON
  REDUCING_BALANCE
}

enum InterestPeriod {
  MONTHLY
  ANNUAL
}

enum CreditStatementStatus {
  PENDING // cycle closed, not yet due
  PARTIAL // some payment received, less than statementBalance
  PAID // fully paid
  OVERDUE // past dueDate, still not fully paid
}

model User {
  id              Int     @id @default(autoincrement())
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  email           String  @unique
  username        String? @unique
  password        String? @map("password")
  role            String  @default("user")
  phoneNumber     String? @map("phone_number")
  profileImageUrl String? @map("profile_image_url")
  isActive        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt
  google_id String?  @unique

  assets            Asset[]
  expenses          Expense[]
  incomes           Income[]
  transfers         Transfer[]
  categories        Categories[]
  categoriesTracker CategoryTracker[]
  recurring         RecurringTransaction[]
  settings          Settings?
  notifications     Notification[]
  resetTokens       ResetToken[]
}

model Asset {
  id Int @id @default(autoincrement())

  name String

  category AssetCategory
  subtype  AssetSubtype?

  currency String @default("PHP")

  // Meaning of `balance` is category-dependent — document it so net-worth /
  // aggregation code doesn't have to guess:
  //   CASH / BANK        -> current available balance
  //   CREDIT             -> current amount owed (positive = liability)
  //   LOAN               -> remaining principal owed (positive = liability)
  //   INVESTMENT         -> current market value, i.e. a denormalized cache of
  //                         (InvestmentPosition.quantity * InvestmentPosition.lastPrice),
  //                         kept in sync by app logic whenever lastPrice/quantity change
  balance Decimal @db.Decimal(20, 8)

  institution String?
  color       String?

  includeInNetWorth Boolean @default(true)
  isActive          Boolean @default(true) // soft-close: paid-off loans, closed cards/accounts

  openedAt DateTime? // when the real-world account/loan/position was opened
  closedAt DateTime? // when it was closed/paid off; null while active

  metadata Json?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Optional relations: default is SetNull, made explicit so deleting an
  // asset never fails or silently changes behavior on a Prisma upgrade —
  // it just detaches the historical record from the account.
  expenses Expense[]
  incomes  Income[]

  sentTransfers     Transfer[] @relation("FromAsset")
  receivedTransfers Transfer[] @relation("ToAsset")

  recurringTransactionFrom RecurringTransaction[] @relation("RecurringTransferFrom")
  recurringTransactionTo   RecurringTransaction[] @relation("RecurringTransferTo")

  loanDetail         LoanDetail?
  investmentPosition InvestmentPosition?
  creditDetail       CreditDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isActive])
}

model LoanDetail {
  id Int @id @default(autoincrement())

  assetId Int   @unique
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  originalPrincipal Decimal @db.Decimal(20, 2)

  // interestRate is always expressed per `interestPeriod` (e.g. 6.2500 + MONTHLY = 6.25%/month).
  // For ADD_ON loans, interest is computed once on originalPrincipal over the full term,
  // not recomputed against a shrinking balance each period — do not reuse REDUCING_BALANCE
  // amortization logic for ADD_ON schedules.
  interestRate   Decimal        @db.Decimal(6, 4) // e.g. 5.2500 = 5.25%
  interestPeriod InterestPeriod
  interestMethod InterestMethod

  termMonths     Int
  minimumPayment Decimal @db.Decimal(20, 2)

  startDate   DateTime // loan origination date — required to compute amortization schedule / maturity
  nextDueDate DateTime? // cached copy of the earliest unpaid installment's dueDate — keep in sync
  // whenever LoanInstallment rows change, or better, derive it at query time
  // from installments to avoid two sources of truth drifting apart

  installments LoanInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanInstallment {
  id Int @id @default(autoincrement())

  loanId Int
  loan   LoanDetail @relation(fields: [loanId], references: [id], onDelete: Cascade)

  installmentNo Int

  dueDate DateTime

  principal Decimal @db.Decimal(20, 2)
  interest  Decimal @db.Decimal(20, 2)

  amountDue      Decimal @db.Decimal(20, 2) // original scheduled amount — don't edit after the fact
  amountPaid     Decimal @default(0) @db.Decimal(20, 2)
  lateFeeCharged Decimal @default(0) @db.Decimal(20, 2) // filled in at payment confirmation from the actual statement, not computed

  status LoanInstallmentStatus @default(PENDING)

  expenseId Int?     @unique // one-to-one: at most one expense records the payment of this installment
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanId, installmentNo]) // prevents duplicate installment numbers on the same loan
  @@index([loanId])
  @@index([dueDate])
}

model CreditDetail {
  id Int @id @default(autoincrement())

  assetId Int   @unique
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  creditLimit           Decimal           @db.Decimal(20, 2)
  statementDate         Int? // day of month (1-31), validate in app layer
  dueDate               Int? // day of month (1-31), validate in app layer
  minimumPaymentPercent Decimal?          @db.Decimal(5, 2) // e.g. 3.00 for 3%
  minimumPaymentFloor   Decimal?          @db.Decimal(20, 2) // e.g. 200.00 flat minimum
  statements            CreditStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per billing cycle. CreditDetail.statementDate/dueDate are just the
// recurring day-of-month config; this is the concrete per-cycle instance,
// same relationship as LoanDetail -> LoanInstallment.
model CreditStatement {
  id Int @id @default(autoincrement())

  creditDetailId Int
  creditDetail   CreditDetail @relation(fields: [creditDetailId], references: [id], onDelete: Cascade)

  statementDate DateTime // date this cycle closed
  dueDate       DateTime // payment due date for this cycle

  statementBalance  Decimal @db.Decimal(20, 2) // original balance as of statementDate — don't edit after the fact
  minimumPaymentDue Decimal @db.Decimal(20, 2)

  amountPaid      Decimal               @default(0) @db.Decimal(20, 2) // sum of linked payments; keep in sync in app logic
  interestCharged Decimal               @default(0) @db.Decimal(20, 2) // filled in at confirmation from the real statement, not computed
  lateFeeCharged  Decimal               @default(0) @db.Decimal(20, 2) // filled in at confirmation from the real statement, not computed
  status          CreditStatementStatus @default(PENDING)

  // 1:many, unlike LoanInstallment <-> Expense — a statement can be paid off
  // across several partial payments.
  payments Transfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creditDetailId, statementDate]) // one statement per cycle
  @@index([creditDetailId])
  @@index([dueDate])
}

model InvestmentPosition {
  id Int @id @default(autoincrement())

  assetId Int   @unique
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  symbol            String // e.g. "AAPL", "BTC"
  quantity          Decimal   @db.Decimal(24, 8)
  averageCostBasis  Decimal   @db.Decimal(20, 8)
  valuationCurrency String    @default("USD") // decoupled from Asset.currency
  lastPrice         Decimal?  @db.Decimal(20, 8)
  lastPriceAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol]) // for batch price-refresh jobs querying by symbol across users
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  amount      Decimal
  image       String?
  status      Status?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId           Int
  categoryId       Int
  assetId          Int?
  recurringId      Int?
  recurringDueDate DateTime?

  loanInstallment LoanInstallment? // back-relation only — FK lives on LoanInstallment.expenseId

  user              User                  @relation(fields: [userId], references: [id])
  category          Categories            @relation(fields: [categoryId], references: [id])
  asset             Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTransaction? @relation("RecurringExpenses", fields: [recurringId], references: [id])

  @@index([userId])
  @@index([recurringId])
}

model Income {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String?
  amount      Decimal
  image       String?
  status      Status?  @default(Pending)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  categoryId  Int
  assetId     Int?
  recurringId Int?

  user              User                  @relation(fields: [userId], references: [id])
  category          Categories            @relation(fields: [categoryId], references: [id])
  asset             Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTransaction? @relation("RecurringIncomes", fields: [recurringId], references: [id])

  @@index([userId])
  @@index([recurringId])
}

model Transfer {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String?
  amount      Decimal
  image       String?
  status      Status   @default(Pending)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId            Int
  categoryId        Int
  fromAssetId       Int
  toAssetId         Int?
  recurringId       Int?
  creditStatementId Int? // set when this expense is a payment toward a credit statement

  user              User                  @relation(fields: [userId], references: [id])
  category          Categories            @relation(fields: [categoryId], references: [id])
  fromAsset         Asset                 @relation("FromAsset", fields: [fromAssetId], references: [id], onDelete: Restrict)
  toAsset           Asset?                @relation("ToAsset", fields: [toAssetId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTransaction? @relation("RecurringTransfers", fields: [recurringId], references: [id])
  creditStatement   CreditStatement?      @relation(fields: [creditStatementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recurringId])
}

model RecurringTransaction {
  id              Int                @id @default(autoincrement())
  type            Type
  description     String
  amount          Decimal
  interval        Int
  unit            String // day | week | month | year
  behaviour       RecurringBehaviour
  status          RecurringStatus    @default(ACTIVE)
  startDate       DateTime
  nextDueDate     DateTime
  endDate         DateTime?
  lastTriggeredAt DateTime?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  userId      Int
  categoryId  Int
  fromAssetId Int? // Transfer: source account
  toAssetId   Int? // Transfer: destination account

  user      User       @relation(fields: [userId], references: [id])
  category  Categories @relation(fields: [categoryId], references: [id])
  fromAsset Asset?     @relation("RecurringTransferFrom", fields: [fromAssetId], references: [id], onDelete: SetNull)
  toAsset   Asset?     @relation("RecurringTransferTo", fields: [toAssetId], references: [id], onDelete: SetNull)

  generatedExpenses  Expense[]      @relation("RecurringExpenses")
  generatedIncomes   Income[]       @relation("RecurringIncomes")
  generatedTransfers Transfer[]     @relation("RecurringTransfers")
  logs               RecurringLog[]
  notifications      Notification[]

  @@index([userId])
  @@index([nextDueDate, status]) // cron query index
}

// Tracks every cron fire for a recurring schedule.
// Acts as audit trail and deduplication guard.
model RecurringLog {
  id           Int                @id @default(autoincrement())
  result       RecurringLogResult
  firedAt      DateTime // UTC timestamp the cron fired
  errorMessage String? // populated when result = FAILED
  createdAt    DateTime           @default(now())

  recurringId         Int
  generatedExpenseId  Int? // set when result = CREATED + type = Expense
  generatedIncomeId   Int? // set when result = CREATED + type = Income
  generatedTransferId Int? // set when result = CREATED + type = Transfer

  recurring RecurringTransaction @relation(fields: [recurringId], references: [id])

  @@unique([recurringId, firedAt]) // prevents duplicate fires on same schedule+date
  @@index([recurringId])
}

model Categories {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  icon      String   @default("default_icon")
  color     String   @default("#6B7280") // neutral gray as fallback
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int?

  user              User?                  @relation(fields: [userId], references: [id])
  expenses          Expense[]
  incomes           Income[]
  transfers         Transfer[]
  categoriesTracker CategoryTracker[]
  recurring         RecurringTransaction[]

  @@unique([userId, name, type])
}

model CategoryTracker {
  id       Int      @id @default(autoincrement())
  limit    Decimal?
  period   String   @default("monthly") // monthly | yearly
  isActive Boolean  @default(true)

  userId     Int
  categoryId Int

  user     User       @relation(fields: [userId], references: [id])
  category Categories @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

model Settings {
  id                 Int                @id @default(autoincrement())
  timezone           String             @default("Asia/Manila")
  timeFormat         String             @default("hh:mm A")
  currency           String             @default("PHP")
  weekStartDay       Int                @default(0) // 0 = Sunday, 1 = Monday
  recurringBehaviour RecurringBehaviour @default(REMIND)
  emailNotification  Boolean            @default(false)
  mobileNotification Boolean            @default(false)
  notifyDays         Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id               Int      @id @default(autoincrement())
  email            String
  verificationCode String
  expirationTime   DateTime
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("email_verifications")
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Notification {
  id      Int              @id @default(autoincrement())
  title   String
  message String
  type    NotificationType @default(General)

  isRead     Boolean @default(false)
  isArchived Boolean @default(false)

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId      Int
  recurringId Int?

  user User @relation(fields: [userId], references: [id])

  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([recurringId])
}

